# Optional: point WorkToper Agent OS at a QEMU binary bundled with the app or installed on the host.
# macOS/Linux example:
# WORKTOPER_QEMU=/opt/homebrew/bin/qemu-system-x86_64
# Windows example:
# WORKTOPER_QEMU=C:\Program Files\qemu\qemu-system-x86_64.exe

# Optional: use a prebuilt VM disk instead of runtime/images/worktoper-agent-os-*.qcow2.
# WORKTOPER_VM_IMAGE=/absolute/path/to/worktoper-agent-os-x64.qcow2
# WORKTOPER_VM_SEED=/absolute/path/to/seed-x64.iso

# VM sizing defaults.
# WORKTOPER_VM_MEMORY=4096
# WORKTOPER_VM_CPUS=4
# WORKTOPER_VM_SIZE=32G

# Keep default open-source packages: Chromium + VSCodium.
# Set to 1 only if you accept Google Chrome and Microsoft VS Code binary licenses.
# WORKTOPER_ALLOW_PROPRIETARY=0

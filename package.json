{
  "name": "worktoper-agent-os",
  "version": "0.1.0",
  "description": "WorkToper Agent OS desktop app with a QEMU-backed Linux desktop VM.",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "main": "desktop/main.cjs",
  "author": "WorkToper",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node desktop/static-server.cjs out",
    "desktop:dev": "next build && electron .",
    "desktop:pack": "next build && electron-builder --dir",
    "dist": "next build && electron-builder",
    "dist:mac": "next build && electron-builder --mac",
    "dist:win": "next build && electron-builder --win",
    "dist:linux": "next build && electron-builder --linux",
    "vm:prepare": "node scripts/prepare-vm.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  },
  "build": {
    "appId": "com.worktoper.agentos",
    "productName": "WorkToper Agent OS",
    "copyright": "Copyright © 2026 WorkToper",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "components/**/*",
      "desktop/**/*",
      "lib/**/*",
      "out/**/*",
      "public/**/*",
      "!runtime/**/*",
      "scripts/**/*",
      "types/**/*",
      "package.json",
      "next.config.mjs",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "runtime/qemu",
        "to": "runtime/qemu",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
